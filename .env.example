# コピーして `.env` にリネームし、値を設定してください（`.env` は Git に含めません）。
# 反映: `npm run env:sync` の後に `ng serve` / `ng build`

# --- Gemini（クライアントから直接叩く場合。本番は Cloud Functions 等への移行を推奨）---
NG_APP_GEMINI_API_KEY=
# 例: gemini-2.0-flash / gemini-1.5-flash など
NG_APP_GEMINI_MODEL=gemini-2.0-flash

# --- Firebase Web アプリ設定（initializeApp 用・未設定なら undefined）---
NG_APP_FIREBASE_API_KEY=
NG_APP_FIREBASE_AUTH_DOMAIN=
NG_APP_FIREBASE_PROJECT_ID=
NG_APP_FIREBASE_STORAGE_BUCKET=
NG_APP_FIREBASE_MESSAGING_SENDER_ID=
NG_APP_FIREBASE_APP_ID=
